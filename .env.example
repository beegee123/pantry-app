# Copy this file to .env.local and fill in the real values.
# Find them in Supabase: Project Settings → API Keys (and the project URL on the same page or under Data API).
# .env.local is ignored by git, so your values are never committed.
#
# Use the PUBLISHABLE (or "anon") key only — never the secret / service_role key.
# After changing .env.local, stop and restart `npm run dev`.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
